// NEAR × Midnight Privacy Bridge — Midnight settlement contract.
//
// Privacy model:
//   - A user locks NEAR on the NEAR testnet contract against
//     nearCommitment = SHA-256(secret).
//   - The bridge relayer verifies that NEAR deposit and registers a
//     domain-separated Midnight commitment on this contract:
//         midnightCommitment = H("near-midnight:commitment:v1", secret)
//     The relayer also escrows the matching tNIGHT amount in this contract.
//   - The user claims by proving knowledge of `secret` such that the derived
//     Midnight commitment is registered. The claim transaction reveals the
//     Midnight commitment, a nullifier and the recipient — but never the NEAR
//     commitment, the NEAR sender, or the secret.
//
// Because the Midnight commitment is a different hash domain from the NEAR
// commitment, an observer of both chains cannot link a NEAR lock to a Midnight
// claim without the secret. The relayer sees the link when it verifies the
// deposit; a decentralized relayer set and Merkle-membership claims are the
// next hardening step.
//
// The contract holds unshielded tNIGHT. `register` pulls the matching amount
// into the contract, so every registered commitment is fully backed.

pragma language_version 0.23;

import CompactStandardLibrary;

// --- Public ledger state -------------------------------------------------

export ledger admin: Bytes<32>;
export ledger tokenColor: Bytes<32>;

// midnightCommitment -> registered amount (0 once claimed)
export ledger deposits: Map<Bytes<32>, Uint<128>>;
// nullifier -> claimed flag
export ledger claimed: Map<Bytes<32>, Boolean>;

export ledger registeredCount: Uint<32>;
export ledger claimedCount: Uint<32>;
export ledger totalLocked: Uint<128>;
export ledger totalClaimed: Uint<128>;

// --- Constructor ---------------------------------------------------------

constructor(adminSecret: Bytes<32>, color: Bytes<32>) {
  admin = disclose(deriveAdmin(adminSecret));
  tokenColor = disclose(color);
  registeredCount = 0;
  claimedCount = 0;
  totalLocked = 0;
  totalClaimed = 0;
}

// --- Domain-separated commitments ---------------------------------------

export pure circuit deriveAdmin(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>(
    [pad(32, "near-midnight:admin:v1"), secret]
  );
}

export pure circuit midnightCommitment(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>(
    [pad(32, "near-midnight:commitment:v1"), secret]
  );
}

export pure circuit nullifier(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>(
    [pad(32, "near-midnight:nullifier:v1"), secret]
  );
}

// --- Relayer registration ------------------------------------------------

// Register a Midnight commitment after verifying the matching NEAR lock.
// The relayer must attach `amount` tNIGHT; it is escrowed in the contract.
export circuit register(
  adminSecret: Bytes<32>,
  commitment: Bytes<32>,
  amount: Uint<128>
): [] {
  assert(admin == deriveAdmin(adminSecret), "not the bridge relayer");
  assert(amount > 0, "amount must be positive");
  assert(!deposits.member(disclose(commitment)), "commitment already registered");

  receiveUnshielded(tokenColor, disclose(amount));

  deposits.insert(disclose(commitment), disclose(amount));
  registeredCount = disclose((registeredCount + 1) as Uint<32>);
  totalLocked = disclose((totalLocked + amount) as Uint<128>);
}

// --- Private claim -------------------------------------------------------

// Claim a registered commitment. The secret is private witness data: the
// proof shows that the derived commitment is registered without revealing the
// secret. The nullifier prevents a second claim of the same commitment.
export circuit claim(
  secret: Bytes<32>,
  commitment: Bytes<32>,
  recipient: UserAddress
): [] {
  const derived = midnightCommitment(secret);
  assert(derived == commitment, "secret does not match commitment");

  const amount = deposits.lookup(disclose(commitment));
  assert(amount > 0, "commitment is not registered");

  const n = nullifier(secret);
  assert(!claimed.member(disclose(n)), "commitment already claimed");

  claimed.insert(disclose(n), true);
  deposits.insert(disclose(commitment), 0);
  claimedCount = disclose((claimedCount + 1) as Uint<32>);
  totalClaimed = disclose((totalClaimed + amount) as Uint<128>);

  sendUnshielded(
    tokenColor,
    disclose(amount),
    right<ContractAddress, UserAddress>(disclose(recipient))
  );
}
