# NEAR Privacy Bridge - Environment Configuration
# Hackathon Submission: Cross-Chain Privacy Bridge between NEAR and Midnight

# NEAR Configuration
VITE_NEAR_CONTRACT_ID=your-near-account.testnet
NEA_RPC_URL=https://rpc.testnet.near.org

# Midnight Configuration
VITE_MIDNIGHT_NETWORK=testnet  # or "preprod" for production

# Proof Server (required for ZK proof generation)
VITE_PROOF_SERVER_URL=http://localhost:6300

# Wallet Configuration
VITE_LACE_NETWORK=testnet  # Lace wallet network setting

# Contract Addresses (fill in after deployment)
VITE_NEAR_BRIDGE_CONTRACT=near1yourbridgeaccounttestnet
VITE_MIDNIGHT_BRIDGE_CONTRACT=midnight1yourbridgeaccount

# Optional: NEAR AI Cloud for private AI integration
VITE_NEAR_AI_CLOUD_KEY=your-near-ai-key-from-cloud.near.ai

# Debug mode
VITE_DEBUG_MODE=false